# Copy this file to .env.local and fill in real values.
# See README.md for details on each variable.

# Required — API key from your Resend dashboard (https://resend.com/api-keys).
# Without this, the site runs fine but the contact form's send action fails.
RESEND_API_KEY=

# Optional — a verified sender address in Resend. Falls back to Resend's
# shared onboarding@resend.dev address if left unset.
RESEND_FROM_EMAIL=
